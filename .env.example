# ============================================================
# TIEM NHA NHO - Environment Variables Template
# Copy sang .env trên máy local hoặc cấu hình trong Render Dashboard
# TUYỆT ĐỐI KHÔNG commit file .env chứa key thật lên Git!
# ============================================================

# Server Port
PORT=5000

# Gemini AI Chatbot
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Shopee Scraper — Phương án B (Third-Party Scraping API: bypass Akamai & JS render)
# Chọn 'auto' để tự động dùng provider nào đã điền key bên dưới,
# hoặc chỉ định cụ thể: zenrows | scraperapi | crawlbase
SCRAPING_PROVIDER=auto

# Điền ít nhất 1 trong 3 API Key dưới đây:
ZENROWS_API_KEY=
SCRAPERAPI_KEY=
CRAWLBASE_TOKEN=

# Vercel Frontend (cấu hình trên Vercel -> Settings -> Environment Variables):
# Trỏ tới domain Backend đã deploy trên Render (kèm /api)
# VITE_API_BASE=https://n-ttnt.onrender.com/api

# ============================================================
# Durable Cloud Database Persistence (Khuyên dùng cho Render Free)
# Render Free reset ổ đĩa container mỗi khi ngủ đông/deploy.
# Gắn 1 trong 2 dịch vụ miễn phí dưới đây trên Render Environment Variables
# để mọi thao tác thêm/xóa/đăng bán sản phẩm & đơn hàng được giữ vĩnh viễn:
# ============================================================
# Cách 1: Upstash Redis REST (miễn phí tại upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cách 2: Supabase Cloud Storage (tùy chọn thay Upstash)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cách 3: Đường dẫn ổ đĩa vĩnh viễn (nếu dùng Render Paid Disk / VPS)
# DB_FILE=/var/data/ecommerce_db.json

